---
import '../styles.css';
import Seo from '@/components/Seo.astro';
import JsonLd from '@/components/JsonLd.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';

export interface Props {
    title: string;
    description?: string;
    image?: string | null;
}

const { title, description, image } = Astro.props;
const { analytics } = siteConfig;
const trackVisits = new URL(siteConfig.url).hostname === analytics.domain;

const orgSchema = siteConfig.business
    ? {
          '@type': siteConfig.business.type,
          name: siteConfig.name,
          url: siteConfig.url,
          telephone: siteConfig.business.telephone,
          address: {
              '@type': 'PostalAddress',
              ...siteConfig.business.address,
          },
          openingHours: siteConfig.business.openingHours,
          ...(siteConfig.business.aggregateRating && {
              aggregateRating: {
                  '@type': 'AggregateRating',
                  ratingValue: siteConfig.business.aggregateRating.ratingValue,
                  reviewCount: siteConfig.business.aggregateRating.reviewCount,
              },
          }),
      }
    : { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url };
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#2e7d32" />
		<Seo title={title} description={description} image={image} />
		<JsonLd schema={orgSchema} />
		<slot name="head" />
		{
			trackVisits && (
				<>
					<script
						is:inline
						defer
						src={analytics.src}
						data-website-id={analytics.websiteId}
						data-domains={analytics.domain}
					/>
					{/*
						Heatmaps. The recorder is ~60 KB of script that held the main thread for ~3 s on a throttled
						phone, so it loads on the visitor's first scroll, tap or key press instead of with the page.
						It only sends once the tracker has a session.
					*/}
					<script is:inline define:vars={{ recorderSrc: analytics.recorderSrc, websiteId: analytics.websiteId }}>
						const events = ['scroll', 'pointerdown', 'touchstart', 'keydown'];
						const load = () => {
							for (const name of events) removeEventListener(name, load);
							const script = document.createElement('script');
							script.src = recorderSrc;
							script.dataset.websiteId = websiteId;
							document.head.append(script);
						};
						for (const name of events) addEventListener(name, load, { passive: true });
					</script>
				</>
			)
		}
	</head>
	<body>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-foreground"
		>
			Skip to content
		</a>
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>